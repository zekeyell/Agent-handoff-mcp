{
  "name": "mcp-file-server",
  "version": "2.0.0",
  "description": "Sandboxed, role-based MCP file-server connector (Streamable HTTP) with a multi-agent handoff protocol",
  "type": "module",
  "main": "dist/index.js",
  "engines": { "node": ">=20.6" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file=.env dist/index.js",
    "dev": "tsx --env-file=.env src/index.ts",
    "test": "tsx --test test/sandbox.test.ts test/server.test.ts",
    "inspector": "npx @modelcontextprotocol/inspector",
    "logs:summary": "node scripts/log-summary.mjs",
    "evidence": "node --env-file=.env scripts/collect-evidence.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
