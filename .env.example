# Copy this file to .env and fill it in. NEVER commit .env.
PORT=3000

# Folder the agents may touch. Must NOT contain this project folder.
WORKSPACE_ROOT=./workspace

# Required (min 16 chars). The server refuses to start without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=

# Your ngrok static domain (ngrok dashboard -> Domains). Used by ecosystem.config.cjs.
NGROK_DOMAIN=your-name.ngrok-free.app

# Logs live OUTSIDE the workspace so agents cannot read or edit their own evidence.
LOG_DIR=./logs
